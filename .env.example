# Base de datos (valores de ejemplo; usa los tuyos en .env)
POSTGRES_USER=drontest
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=drontest
POSTGRES_PORT=5433
DATABASE_URL=postgresql://drontest:cambia-esta-clave@localhost:5433/drontest?schema=public

# NextAuth
# Genera el secreto con: openssl rand -base64 32
NEXTAUTH_SECRET=genera-un-secreto-aleatorio
NEXTAUTH_URL=http://localhost:3000
